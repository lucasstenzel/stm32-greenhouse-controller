{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "mingw32-make",
      "args": ["-j4"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "mingw32-make",
      "args": ["clean"],
      "problemMatcher": []
    },
    {
      "label": "Flash",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f", "interface/stlink.cfg",
        "-f", "target/stm32f4x.cfg",
        "-c", "program build/greenhouseController.elf verify reset exit"
      ],
      "dependsOn": "Build",
      "problemMatcher": []
    }
  ]
}